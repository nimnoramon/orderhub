# --- Database (Neon) -------------------------------------------------------
# Use the POOLED connection string (the host contains "-pooler").
# Two Neon branches: `dev` for your machine, `production` for Vercel.
# sslmode=verify-full is spelled out on purpose: node-postgres treats a bare
# `require` as verify-full today, but will drop to libpq semantics in pg v9.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# --- Auth ------------------------------------------------------------------
# Signs the demo session cookie. Any long random string: `openssl rand -hex 32`
SESSION_SECRET="change-me"

# Seeded demo login. Shown on the login screen on purpose — it is a public demo.
DEMO_EMAIL="demo@orderhub.dev"
DEMO_PASSWORD="demo1234"

# --- Mock marketplaces -----------------------------------------------------
# HMAC secrets the mock channels sign their webhooks with, and the token the
# webhook receiver checks before it does any work.
MOCK_A_WEBHOOK_SECRET="mock-a-secret"
MOCK_B_WEBHOOK_SECRET="mock-b-secret"
WEBHOOK_VERIFY_TOKEN="orderhub-demo-token"

# Base URL the adapters call the in-app mock marketplaces on.
APP_BASE_URL="http://localhost:3000"

# --- Redis (Upstash) — not needed until milestone 6 -------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
