# Copy to `.env` for local work. For the deployed demo, the same keys go into
# Vercel's Environment Variables, and a second copy lives in `.env.prod`
# (gitignored) so `pnpm db:deploy:prod` and `pnpm db:seed:prod` can reach the
# Neon production branch from your laptop. See "Deploy" in the README.
#
# Marked [now] if something reads it today, [mN] if the milestone that reads it
# has not been built yet. The app only refuses to start without DATABASE_URL.

# --- Database (Neon) -------------------------------------------------------
# [now] Use the POOLED connection string (the host contains "-pooler").
# Two Neon branches: `dev` for your machine, `production` for Vercel.
# sslmode=verify-full is spelled out on purpose: node-postgres treats a bare
# `require` as verify-full today, but will drop to libpq semantics in pg v9.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# --- Demo login ------------------------------------------------------------
# [now] Hashed into the seeded user, and printed on the landing page — this is
# a public demo and the way in should not be a puzzle. Override both together.
DEMO_EMAIL="demo@orderhub.dev"
DEMO_PASSWORD="demo1234"

# [later] Signs the demo session cookie. The seed already hashes the password
# above with bcrypt, but the login screen itself is not built — until it is,
# the dashboard is open and nothing reads this. Any long random string:
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET="change-me"

# --- Mock marketplaces -----------------------------------------------------
# [now] The API key MockShop A checks on every call. The seed stores the same
# value in the channel's `credentials`, and the adapter reads it from there —
# this variable is the mock's side of the same secret, so changing one without
# the other is how you find out the 401 path works.
MOCK_A_API_KEY="mock-a-key"

# [now] MockShop B authenticates with HTTP Basic instead, because two
# marketplaces that had never met would not have agreed on a header. Same
# arrangement: the seed writes both onto the channel row and the adapter reads
# them from there, so change these before seeding if you change them at all.
MOCK_B_CLIENT_ID="mock-b-client"
MOCK_B_CLIENT_SECRET="mock-b-secret-key"

# [now] HMAC secrets the mock channels sign their webhooks with, and the token
# in the webhook URL each of them was given. The receiver checks the token
# before it does any work and the signature before it believes anything; the
# token is in the URL because a marketplace is configured with a URL, which also
# means it is the weaker of the two and is treated that way.
MOCK_A_WEBHOOK_SECRET="mock-a-secret"
MOCK_B_WEBHOOK_SECRET="mock-b-secret"
WEBHOOK_VERIFY_TOKEN="orderhub-demo-token"

# [now] Base URL the adapters call the in-app mock marketplaces on — they go
# over real HTTP rather than importing each other. Unset on Vercel it falls back
# to the deployment's own VERCEL_URL, which is right for previews too.
APP_BASE_URL="http://localhost:3000"

# --- Redis (Upstash) -------------------------------------------------------
# [m6] Rate limiter, retry queue and the cached dashboard summary.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
